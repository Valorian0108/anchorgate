# Environment variables (placeholders only — never commit real values).
#
# Copy this file to `.env` and fill in your own values. `.env` is gitignored.
# Do NOT paste real secrets into chat, code, screenshots, or logs.

# --- Durable storage: Supabase PostgreSQL ---------------------------------
#
# Find these in Supabase: Project Settings -> Database -> Connection string.
#
# Application runtime connection (Supabase connection pooler).
# The application disables prepared statements automatically for pooling.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<host>:6543/postgres"

# Migrations connection (session / direct). Used only by `npm run db:migrate`.
DATABASE_URL_DIRECT="postgresql://postgres.<project-ref>:<password>@<host>:5432/postgres"

# --- PayPal Sandbox (Phase 4) ----------------------------------------------
# Sandbox-only. The code REFUSES a non-sandbox environment (no live funds).
# Create a Sandbox app + credentials in the PayPal Developer Dashboard:
#   Apps & Credentials -> Sandbox -> your app -> Client ID / Secret.
# Fill these in locally only; never commit real values.
PAYPAL_ENV="sandbox"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""

# PayPal webhook id (Phase 4 completion). PayPal posts capture-completed
# notifications to /api/paypal/webhook; this id is the one PayPal shows after
# you register that URL in your Sandbox app's Webhooks settings. Leave blank
# and webhooks still arrive, but their signatures cannot be verified.
PAYPAL_WEBHOOK_ID=""

# --- AI agent (Phase 5) ----------------------------------------------------
# The agent proposes purchases; the deterministic authorizer decides.
#
# The endpoint must be OpenAI-compatible. Experiential Labs is an
# OpenAI-compatible gateway/router, so its base URL is the default below.
# Fill in your own key locally; never commit it.
AGENT_BASE_URL="https://api.experientiallabs.ai/v1"
AGENT_API_KEY=""
# The model id/alias to use (e.g. a public alias from your provider).
# List choices with `npm run agent:models`, or copy one from the provider.
AGENT_MODEL=""
# Optional label recorded on every proposed purchase. Defaults to "ai-agent".
AGENT_ID="ai-agent"

# --- Owner sign-in (Slice 6) -----------------------------------------------
# Owner-only identity via Supabase Auth (magic link primary, Google secondary).
# Find the URL and anon key in Supabase: Project Settings -> API.
# The anon key is public (safe for the browser) and grants no data by itself.
# NEVER use the service_role key here: it bypasses row-level security.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_ANON_KEY=""

# The single email address allowed to open the gate. With this unset the gate
# fails closed — nobody is the owner.
OWNER_EMAIL=""

# Secret used to sign the 30-minute idle-session cookie (HMAC). Generate a
# random value; rotate it to invalidate all idle stamps at once.
SESSION_SECRET=""
