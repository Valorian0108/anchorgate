# Environment variables (placeholders only — never commit real values).
#
# Copy this file to `.env` and fill in your own values. `.env` is gitignored.
# Do NOT paste real secrets into chat, code, screenshots, or logs.

# --- Durable storage: Supabase PostgreSQL ---------------------------------
#
# Find these in Supabase: Project Settings -> Database -> Connection string.
#
# Application runtime connection (Supabase connection pooler).
# The application disables prepared statements automatically for pooling.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<host>:6543/postgres"

# Migrations connection (session / direct). Used only by `npm run db:migrate`.
DATABASE_URL_DIRECT="postgresql://postgres.<project-ref>:<password>@<host>:5432/postgres"

# --- PayPal Sandbox (Phase 4) ----------------------------------------------
# Sandbox-only. The code REFUSES a non-sandbox environment (no live funds).
# Create a Sandbox app + credentials in the PayPal Developer Dashboard:
#   Apps & Credentials -> Sandbox -> your app -> Client ID / Secret.
# Fill these in locally only; never commit real values.
PAYPAL_ENV="sandbox"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
