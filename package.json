{
  "name": "spend-authorizer",
  "version": "0.1.0",
  "private": true,
  "description": "Independent authorization layer for AI-initiated purchases (working scaffold).",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "sandbox:verify": "tsx scripts/sandbox-verify.ts",
    "sandbox:verify:wallet": "tsx scripts/sandbox-verify.ts --wallet",
    "vault:card": "tsx scripts/vault-card.ts",
    "agent": "tsx scripts/agent-cli.ts",
    "agent:models": "tsx scripts/agent-models.ts",
    "purchase": "tsx scripts/purchase.ts",
    "rules:show": "tsx scripts/rules.ts show",
    "rules:set": "tsx scripts/rules.ts set",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "tsx scripts/db-check.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.67",
    "@paypal/paypal-server-sdk": "^2.5.0",
    "ai": "^7.0.136",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.0",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
